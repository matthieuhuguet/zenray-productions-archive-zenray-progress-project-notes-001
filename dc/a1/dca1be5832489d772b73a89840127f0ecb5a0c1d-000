<!DOCTYPE html>
<html lang="fr" data-theme="dark" data-body-font="gtstandard">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZenRay Progress — Rework Galerie ToDo-3D (4 Vues & Font Swap)</title>
  <style>
    @font-face {
      font-family: 'GT Ultra';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/GT-Ultra-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'GT Standard L';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/GT-Standard-L-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'GT Standard L';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/GT-Standard-L-Bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Literata';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/Literata-latin.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    :root {
      /* Titres et chiffres TOUJOURS en GT Ultra 400 */
      --font-title: 'GT Ultra', -apple-system, sans-serif;
      --font-num: 'GT Ultra', -apple-system, sans-serif;
      /* Police de corps commutable via data-body-font */
      --font-body: 'GT Standard L', -apple-system, sans-serif;
      --font-ui: 'GT Standard L', -apple-system, sans-serif;

      --bg: #121214;
      --surface: #1c1c20;
      --surface-subtle: #24242a;
      --border: rgba(255, 255, 255, 0.08);
      --ink: #f4f4f6;
      --muted: #9a9aa2;
      --accent: #0a84ff;
      --accent-soft: rgba(10, 132, 255, 0.16);
      --letterbox: rgba(255, 255, 255, 0.03);

      /* Paramètres réglables par sliders */
      --gal-cols: 4;
      --gal-gap: 18px;
      --gal-radius: 8px;
      --gal-ratio: 4 / 3;
      --gal-fit: cover;
    }

    /* Mode Literata pour le corps */
    html[data-body-font="literata"] {
      --font-body: 'Literata', Georgia, serif;
    }
    html[data-body-font="gtstandard"] {
      --font-body: 'GT Standard L', -apple-system, sans-serif;
    }

    [data-theme="light"] {
      --bg: #f7f7f9;
      --surface: #ffffff;
      --surface-subtle: #f0f0f3;
      --border: rgba(0, 0, 0, 0.08);
      --ink: #16161a;
      --muted: #6e6e76;
      --accent: #0071e3;
      --accent-soft: rgba(0, 113, 227, 0.12);
      --letterbox: rgba(0, 0, 0, 0.03);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 14px;
      line-height: 1.5;
      padding-bottom: 90px;
      transition: background 0.2s ease, color 0.2s ease;
      -webkit-font-smoothing: antialiased;
    }

    /* Typographie */
    .title, h1, h2, h3, .zrm-title {
      font-family: var(--font-title) !important;
      font-weight: 400 !important;
      letter-spacing: -0.015em;
    }
    .num, .zrm-num {
      font-family: var(--font-num) !important;
      font-variant-numeric: tabular-nums;
      font-weight: 400 !important;
    }
    .ui, button, label, input, select, .badge {
      font-family: var(--font-ui);
      font-size: 13px;
    }
    p, .note-text, .caption-note {
      font-family: var(--font-body);
    }

    /* PANNEAU SUPÉRIEUR HDA FIXE */
    .control-deck {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(22, 22, 26, 0.92);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 12px 28px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.30);
    }
    [data-theme="light"] .control-deck {
      background: rgba(255, 255, 255, 0.94);
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    .deck-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
    }

    .propositions-tabs {
      display: inline-flex;
      background: var(--surface-subtle);
      padding: 3px;
      border-radius: 9px;
      border: 1px solid var(--border);
      gap: 3px;
      max-width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .propositions-tabs::-webkit-scrollbar {
      display: none;
    }

    .prop-tab {
      padding: 7px 13px;
      border-radius: 7px;
      border: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: all 0.16s ease;
    }
    .prop-tab.active {
      background: var(--surface);
      color: var(--ink);
      box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    }
    .prop-tab .tab-idx {
      font-family: var(--font-num);
      font-size: 12px;
      opacity: 0.65;
    }

    /* Contrôles droits : Font swap, Thème, Copier */
    .deck-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .font-swap-group {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      background: var(--surface-subtle);
      padding: 3px 5px;
      border-radius: 8px;
      border: 1px solid var(--border);
    }
    .font-swap-group .label-tag {
      font-size: 11px;
      color: var(--muted);
      padding: 0 5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .font-toggle-btn {
      padding: 4px 10px;
      border-radius: 6px;
      border: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 500;
      transition: all 0.15s ease;
    }
    .font-toggle-btn.active {
      background: var(--surface);
      color: var(--ink);
      box-shadow: 0 1px 4px rgba(0,0,0,0.16);
      font-weight: 600;
    }

    .btn-tool {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--ink);
      padding: 6px 12px;
      border-radius: 7px;
      cursor: pointer;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: background 0.15s ease, border-color 0.15s ease;
    }
    .btn-tool:hover {
      background: var(--accent-soft);
      border-color: var(--accent);
    }

    /* Sliders HDA */
    .deck-sliders {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
      font-family: var(--font-ui);
      font-size: 12px;
      border-top: 1px solid var(--border);
      padding-top: 8px;
    }

    .slider-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .slider-group label {
      color: var(--muted);
      white-space: nowrap;
    }
    .slider-group .slider-val {
      font-family: var(--font-num);
      color: var(--ink);
      min-width: 26px;
      text-align: right;
    }
    .slider-group input[type="range"] {
      width: 80px;
      accent-color: var(--accent);
      cursor: pointer;
    }
    .select-pill {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--ink);
      padding: 3px 8px;
      border-radius: 6px;
      cursor: pointer;
      font-family: var(--font-ui);
      font-size: 12px;
    }

    /* Conteneur */
    .container {
      max-width: 1680px;
      margin: 0 auto;
      padding: 30px 36px;
    }

    .view-hero {
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px;
    }
    .view-hero h1 {
      font-size: 30px;
      color: var(--ink);
      line-height: 1.15;
    }
    .view-hero .subtitle {
      color: var(--muted);
      font-size: 14px;
      margin-top: 6px;
    }
    .hero-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 13px;
    }

    /* Grille principale paramétrique */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(var(--gal-cols), minmax(0, 1fr));
      gap: var(--gal-gap);
      align-items: start;
    }

    /* Tuiles */
    .tile {
      position: relative;
      background: var(--surface);
      border-radius: var(--gal-radius);
      overflow: hidden;
      border: 1px solid var(--border);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .tile:hover {
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 12px 32px rgba(0,0,0,0.30);
    }
    [data-theme="light"] .tile:hover {
      border-color: rgba(0, 0, 0, 0.15);
      box-shadow: 0 12px 32px rgba(0,0,0,0.10);
    }

    .media-box {
      width: 100%;
      aspect-ratio: var(--gal-ratio);
      background: var(--letterbox);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .media-box img, .media-box video {
      width: 100%;
      height: 100%;
      object-fit: var(--gal-fit);
      display: block;
      transition: transform 0.25s ease;
    }
    .tile:hover .media-box img, .tile:hover .media-box video {
      transform: scale(1.02);
    }

    .media-badge {
      position: absolute;
      bottom: 8px;
      right: 8px;
      padding: 3px 7px;
      background: rgba(14, 14, 18, 0.82);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #fff;
      border-radius: 5px;
      font-family: var(--font-ui);
      font-weight: 700;
      font-size: 10px;
      letter-spacing: 0.05em;
      pointer-events: none;
      border: 1px solid rgba(255, 255, 255, 0.12);
      z-index: 3;
    }

    .play-indicator {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 28px;
      height: 28px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      backdrop-filter: blur(6px);
      pointer-events: none;
      transition: all 0.2s ease;
      z-index: 3;
    }
    .tile.is-playing .play-indicator {
      background: var(--accent);
      transform: scale(0.9);
    }

    /* Mosaïque 2x2 des dossiers de projets */
    .folder-mosaic {
      width: 100%;
      height: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: 2px;
      background: var(--border);
    }
    .folder-mosaic img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* VUE 01 : ÉPURÉE MINIMAL */
    .prop-view[data-prop="1"] .gallery-grid {
      --gal-gap: 16px;
    }
    .prop-view[data-prop="1"] .tile {
      border: 0;
      background: transparent;
      box-shadow: none;
    }
    .prop-view[data-prop="1"] .media-box {
      border-radius: var(--gal-radius);
      box-shadow: 0 3px 14px rgba(0,0,0,0.18);
    }
    .prop-view[data-prop="1"] .caption {
      padding: 10px 2px 4px;
      background: transparent;
    }
    .prop-view[data-prop="1"] .caption-title {
      font-size: 14px;
      font-weight: 500;
      color: var(--ink);
      margin-bottom: 2px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .prop-view[data-prop="1"] .caption-note {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    /* VUE 02 : ÉPURÉE OVERLAY (Titres flottants en haut à droite) */
    .prop-view[data-prop="2"] .tile {
      border: 1px solid var(--border);
      background: var(--surface);
    }
    .prop-view[data-prop="2"] .floating-overlay {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 5;
      max-width: calc(100% - 36px);
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.68);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.32);
      opacity: 0;
      transform: translateY(-4px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      pointer-events: none;
      box-sizing: border-box;
    }
    .prop-view[data-prop="2"] .tile:hover .floating-overlay {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    .prop-view[data-prop="2"] .floating-title {
      font-family: var(--font-title);
      font-size: 13px;
      font-weight: 400;
      margin: 0;
      line-height: 1.25;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: -0.01em;
    }
    .prop-view[data-prop="2"] .floating-note {
      display: none;
    }

    /* VUE 03 : ÉPURÉE STUDIO (Tags & Scrubber) */
    .prop-view[data-prop="3"] .caption {
      padding: 12px 14px;
      background: var(--surface);
    }
    .prop-view[data-prop="3"] .caption-title {
      font-size: 15px;
      margin-bottom: 4px;
    }
    .prop-view[data-prop="3"] .caption-tags {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 8px;
    }
    .prop-view[data-prop="3"] .tag-pill {
      font-size: 10px;
      font-weight: 600;
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--muted);
      padding: 2px 7px;
      border-radius: 4px;
      letter-spacing: 0.04em;
    }
    .prop-view[data-prop="3"] .scrub-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: rgba(255, 255, 255, 0.2);
      z-index: 5;
    }
    .prop-view[data-prop="3"] .scrub-fill {
      height: 100%;
      width: 0%;
      background: var(--accent);
    }

    /* ══════════════════════════════════════════════════════════
       VUE 04 : EXISTANT PIXEL-PERFECT (ZenRayProgress Replica)
       ══════════════════════════════════════════════════════════ */
    .zr-reference-gallery {
      width: 100%;
      background: var(--bg);
      color: var(--ink);
    }
    .zr-gallery-hero {
      margin: 10px 0 24px;
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 24px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 16px;
    }
    .zr-gallery-hero h1 {
      margin: 0;
      font-size: 32px;
      line-height: 1.15;
    }
    .zr-gallery-nav {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 16px;
      font-family: var(--font-ui);
      font-size: 13px;
    }
    .zr-breadcrumb-crumb {
      background: transparent;
      border: 0;
      color: var(--muted);
      cursor: pointer;
      font-weight: 500;
      padding: 3px 6px;
      border-radius: 5px;
    }
    .zr-breadcrumb-crumb:hover {
      background: var(--surface-subtle);
      color: var(--ink);
    }
    .zr-breadcrumb-crumb.active {
      color: var(--ink);
      font-weight: 600;
    }

    /* Grille et tuiles de l'existant */
    .zr-gallery-grid {
      display: grid;
      grid-template-columns: repeat(var(--gal-cols), minmax(0, 1fr));
      gap: var(--gal-gap);
      align-items: start;
    }
    .zr-gallery-tile {
      position: relative;
    }
    .zr-gallery-visual {
      aspect-ratio: var(--gal-ratio);
      border-radius: var(--gal-radius);
      background: var(--letterbox);
      overflow: hidden;
      position: relative;
      cursor: zoom-in;
      border: 1px solid var(--border);
    }
    .zr-gallery-visual img, .zr-gallery-visual video {
      width: 100%;
      height: 100%;
      object-fit: var(--gal-fit);
      display: block;
    }

    /* Légende Overlay actuelle de ZenRayProgress */
    .zr-gallery-caption {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 2;
      padding: 40px 16px 14px;
      background: linear-gradient(transparent, rgba(0,0,0,0.88));
      color: #fff;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity 0.18s ease, transform 0.18s ease;
      pointer-events: none;
    }
    .zr-gallery-visual:hover > .zr-gallery-caption {
      opacity: 1;
      transform: none;
    }
    .zr-gallery-caption h3 {
      font-family: var(--font-title);
      font-size: 15px;
      line-height: 1.25;
      margin: 0 0 4px;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .zr-gallery-caption a {
      color: inherit;
      text-decoration: none;
      font-family: var(--font-ui);
      font-size: 11px;
      pointer-events: auto;
      opacity: 0.85;
    }
    .zr-gallery-caption a:hover {
      text-decoration: underline;
      opacity: 1;
    }
    .zr-gallery-caption p {
      margin: 6px 0 0;
      font-family: var(--font-body);
      font-size: 12px;
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      opacity: 0.9;
    }
    .zr-gallery-count {
      font-family: var(--font-body);
      font-size: 11px;
      margin-left: 8px;
      opacity: 0.75;
    }

    /* Croix de suppression existante */
    .zr-gallery-remove {
      position: absolute;
      top: 6px;
      left: 6px;
      width: 22px;
      height: 22px;
      border-radius: 999px;
      border: 0;
      background: rgba(0,0,0,0.60);
      color: #fff;
      display: grid;
      place-items: center;
      cursor: pointer;
      opacity: 0;
      transition: opacity 0.15s ease;
      z-index: 4;
      font-size: 12px;
    }
    .zr-gallery-tile:hover .zr-gallery-remove {
      opacity: 1;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #10b981;
      color: #fff;
      padding: 10px 18px;
      border-radius: 8px;
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 13px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.3);
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.25s ease;
      pointer-events: none;
      z-index: 200;
    }
    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

  <!-- DECK SUPÉRIEUR HDA (PROPOSITIONS, FONT SWAP & SLIDERS) -->
  <header class="control-deck">
    <div class="deck-top">
      <div class="propositions-tabs ui" role="tablist">
        <button type="button" class="prop-tab active" data-target="1">
          <span class="tab-idx num">01</span>
          <span>Épurée Minimal</span>
        </button>
        <button type="button" class="prop-tab" data-target="2">
          <span class="tab-idx num">02</span>
          <span>Épurée Overlay</span>
        </button>
        <button type="button" class="prop-tab" data-target="3">
          <span class="tab-idx num">03</span>
          <span>Épurée Studio</span>
        </button>
        <button type="button" class="prop-tab" data-target="4">
          <span class="tab-idx num">04</span>
          <span>Existant Pixel-Perfect</span>
        </button>
      </div>

      <div class="deck-actions ui">
        <!-- SWAP TYPOGRAPHIQUE DU CORPS (TITRES RESTENT EN GT ULTRA) -->
        <div class="font-swap-group" title="Changer la police de corps (les titres restent en GT Ultra)">
          <span class="label-tag">Corps :</span>
          <button type="button" class="font-toggle-btn active" id="btnFontGt">GT Standard L</button>
          <button type="button" class="font-toggle-btn" id="btnFontLiterata">Literata</button>
        </div>

        <button type="button" class="btn-tool" id="themeToggle" title="Basculer thème clair/sombre">🌓 Thème</button>
        <button type="button" class="btn-tool" id="copyCssBtn" title="Copier les variables CSS calibrées pour le prompt">📋 Copier CSS</button>
      </div>
    </div>

    <!-- CURSEURS PARAMÉTRIQUES EN DIRECT -->
    <div class="deck-sliders">
      <div class="slider-group">
        <label for="colSlider">Colonnes :</label>
        <input type="range" id="colSlider" min="2" max="6" value="4" step="1">
        <span class="slider-val" id="colVal">4</span>
      </div>

      <div class="slider-group">
        <label for="gapSlider">Espacement :</label>
        <input type="range" id="gapSlider" min="8" max="36" value="18" step="2">
        <span class="slider-val" id="gapVal">18px</span>
      </div>

