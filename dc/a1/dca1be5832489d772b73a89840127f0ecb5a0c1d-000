  <script>
    // ── GESTION DES 4 ONGLETS ──
    const tabs = document.querySelectorAll('.prop-tab');
    const views = document.querySelectorAll('.prop-view');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const target = tab.dataset.target;
        views.forEach(v => {
          v.style.display = (v.dataset.prop === target) ? 'block' : 'none';
        });
      });
    });

    // ── FONT SWAP INTERACTIF (CORPS : GT STANDARD L <-> LITERATA) ──
    const htmlEl = document.documentElement;
    const btnFontGt = document.getElementById('btnFontGt');
    const btnFontLiterata = document.getElementById('btnFontLiterata');
    const currentBodyFontName = document.getElementById('currentBodyFontName');

    btnFontGt.addEventListener('click', () => {
      htmlEl.setAttribute('data-body-font', 'gtstandard');
      btnFontGt.classList.add('active');
      btnFontLiterata.classList.remove('active');
      currentBodyFontName.textContent = 'GT Standard L';
    });

    btnFontLiterata.addEventListener('click', () => {
      htmlEl.setAttribute('data-body-font', 'literata');
      btnFontLiterata.classList.add('active');
      btnFontGt.classList.remove('active');
      currentBodyFontName.textContent = 'Literata';
    });

    // ── SLIDERS PARAMÉTRIQUES HDA ──
    const colSlider = document.getElementById('colSlider');
    const colVal = document.getElementById('colVal');
    colSlider.addEventListener('input', (e) => {
      htmlEl.style.setProperty('--gal-cols', e.target.value);
      colVal.textContent = e.target.value;
      // Sync switch de colonnes de la vue 4
      document.querySelectorAll('.btn-col').forEach(b => {
        b.classList.toggle('active', b.dataset.cols === e.target.value);
      });
    });

    const gapSlider = document.getElementById('gapSlider');
    const gapVal = document.getElementById('gapVal');
    gapSlider.addEventListener('input', (e) => {
      htmlEl.style.setProperty('--gal-gap', e.target.value + 'px');
      gapVal.textContent = e.target.value + 'px';
    });

    const radiusSlider = document.getElementById('radiusSlider');
    const radiusVal = document.getElementById('radiusVal');
    radiusSlider.addEventListener('input', (e) => {
      htmlEl.style.setProperty('--gal-radius', e.target.value + 'px');
      radiusVal.textContent = e.target.value + 'px';
    });

    const ratioSelect = document.getElementById('ratioSelect');
    ratioSelect.addEventListener('change', (e) => {
      htmlEl.style.setProperty('--gal-ratio', e.target.value);
    });

    const fitSelect = document.getElementById('fitSelect');
    fitSelect.addEventListener('change', (e) => {
      htmlEl.style.setProperty('--gal-fit', e.target.value);
    });

    // ── SWITCH COLONNES DE LA VUE 4 ──
    document.querySelectorAll('.btn-col').forEach(btn => {
      btn.addEventListener('click', () => {
        const c = btn.dataset.cols;
        colSlider.value = c;
        htmlEl.style.setProperty('--gal-cols', c);
        colVal.textContent = c;
        document.querySelectorAll('.btn-col').forEach(b => {
          b.style.background = (b === btn) ? 'var(--surface)' : 'transparent';
          b.style.color = (b === btn) ? 'var(--ink)' : 'var(--muted)';
          b.style.boxShadow = (b === btn) ? '0 1px 3px rgba(0,0,0,.14)' : 'none';
        });
      });
    });

    // ── THÈME CLAIR / SOMBRE ──
    const themeToggle = document.getElementById('themeToggle');
    themeToggle.addEventListener('click', () => {
      const current = htmlEl.getAttribute('data-theme');
      htmlEl.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
    });

    // ── HOVER PLAY / PAUSE SUR MP4 ET GIF ──
    const videoTiles = document.querySelectorAll('.video-tile');
    videoTiles.forEach(tile => {
      const video = tile.querySelector('video');
      const scrubFill = tile.querySelector('.scrub-fill');
      if (!video) return;

      tile.addEventListener('mouseenter', () => {
        tile.classList.add('is-playing');
        video.play().catch(() => {});
      });

      tile.addEventListener('mouseleave', () => {
        tile.classList.remove('is-playing');
        video.pause();
      });

      if (scrubFill) {
        video.addEventListener('timeupdate', () => {
          if (video.duration) {
            const pct = (video.currentTime / video.duration) * 100;
            scrubFill.style.width = pct + '%';
          }
        });
      }
    });

    // ── COPIER RÉGLAGES CSS POUR LE PROMPT ──
    const copyCssBtn = document.getElementById('copyCssBtn');
    const toast = document.getElementById('toast');
    copyCssBtn.addEventListener('click', () => {
      const bodyFontChoice = htmlEl.getAttribute('data-body-font') === 'literata' ? "'Literata', serif" : "'GT Standard L', sans-serif";
      const cssString = `:root {
  --gallery-columns: ${colSlider.value};
  --gallery-gap: ${gapSlider.value}px;
  --gallery-radius: ${radiusSlider.value}px;
  --gallery-image-ratio: ${ratioSelect.value};
  --gallery-image-fit: ${fitSelect.value};
  --font-title: 'GT Ultra', sans-serif;
  --font-num: 'GT Ultra', sans-serif;
  --font-body: ${bodyFontChoice};
  --font-ui: 'GT Standard L', sans-serif;
}`;
      navigator.clipboard.writeText(cssString).then(() => {
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2400);
      });
    });
  </script>
</body>
</html>
