<script>
// Mise à jour réactive des variables CSS en direct par les sliders
function updateParam(cssVar, cssVal, labelId, rawVal) {
  document.documentElement.style.setProperty(cssVar, cssVal);
  const el = document.getElementById(labelId);
  if (el) el.textContent = rawVal;
}

// Bascule interactive entre onglets Séance / Last Sessions / Objectif visuel
function switchSportTab(tabName) {
  const btnSeance = document.getElementById('btnTabSeance');
  const btnLast = document.getElementById('btnTabLast');
  const btnGoal = document.getElementById('btnTabGoal');

  const lastBadges = document.querySelectorAll('.zrs-glass-badge');
  const planSeanceView = document.getElementById('planSeanceView');
  const planLastSessionsView = document.getElementById('planLastSessionsView');
  const planColTitle = document.getElementById('planColTitle');
  const planColSubtitle = document.getElementById('planColSubtitle');

  btnSeance.classList.remove('is-active');
  btnLast.classList.remove('is-active');
  btnGoal.classList.remove('is-active');

  if (tabName === 'seance') {
    btnSeance.classList.add('is-active');
    lastBadges.forEach(el => el.style.display = 'none');
    planSeanceView.style.display = 'block';
    planLastSessionsView.style.display = 'none';
    planColTitle.textContent = 'Plan';
    planColSubtitle.innerHTML = 'Today · <span class="num">23 October 2026</span>';
  } else if (tabName === 'lastSessions') {
    btnLast.classList.add('is-active');
    lastBadges.forEach(el => el.style.display = 'inline-flex');
    planSeanceView.style.display = 'none';
    planLastSessionsView.style.display = 'flex';
    planColTitle.textContent = 'Dernière séance';
    planColSubtitle.innerHTML = 'Historique · <span class="num">21 October 2026</span>';
  } else if (tabName === 'goal') {
    btnGoal.classList.add('is-active');
    alert('Onglet Objectif visuel sélectionné.');
  }
}

// Bascule du thème clair / sombre
function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme');
  const next = current === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
}

// Copie des réglages HDA pour le prompt
function copyPromptValues() {
  const titleSize = getComputedStyle(document.documentElement).getPropertyValue('--ex-title-size').trim();
  const badgeSize = getComputedStyle(document.documentElement).getPropertyValue('--badge-font-size').trim();
  const blurVal = getComputedStyle(document.documentElement).getPropertyValue('--glass-blur').trim();
  const opacityVal = getComputedStyle(document.documentElement).getPropertyValue('--glass-opacity').trim();
  const shadowVal = getComputedStyle(document.documentElement).getPropertyValue('--badge-shadow-blur').trim();
  const summary = `Réglages Sport HDA validés (23 October 2026) :
- Fonte titres : GT Sectra Normal Regular Italic 400
- Taille titres exercices : ${titleSize}
- Taille police badge poids : ${badgeSize}
- Flou Liquid Glass : ${blurVal}
- Opacité Liquid Glass : ${opacityVal}
- Drop shadow texte badge : ${shadowVal}
- Capsule : arrondie à 999 en haut à droite avec poids seul et drop shadow sans stroke`;
  navigator.clipboard.writeText(summary).then(() => {
    alert('Valeurs copiées dans le presse-papier !');
  });
}
</script>
