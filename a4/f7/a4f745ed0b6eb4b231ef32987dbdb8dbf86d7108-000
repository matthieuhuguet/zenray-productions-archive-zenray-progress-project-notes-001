<!doctype html>
<html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sport D Simple</title>
<link rel="stylesheet" href="sport-shared.css">
<style>
/* D: the simple version. One list, one tap to log, each logged exercise lands in Plan as a task. 16 October 2026 */
.cols{display:flex;flex:1;min-height:0}
.sport{flex:1.4;min-width:0;display:flex;flex-direction:column;padding:0 20px 16px;gap:10px}
.plan{flex:1;min-width:250px;border-left:.5px solid var(--sp-line);display:flex;flex-direction:column;padding:16px 16px 12px;gap:10px;background:rgba(128,128,128,.04)}
.mob .sport{padding:0 16px 10px}.mob .plan{border:0;flex:1;min-width:0}
.find{position:relative}.find .res{position:absolute;left:0;right:0;top:40px;z-index:4;max-height:260px;overflow:auto;padding:6px;border-radius:var(--sp-r);background:var(--sp-bg);box-shadow:0 12px 40px rgba(0,0,0,.18),0 0 0 .5px var(--sp-line)}
.res button{display:flex;gap:10px;align-items:center;width:100%;border:0;background:transparent;padding:6px;border-radius:9px;text-align:left}.res button:hover,.res button.hl{background:var(--sp-accent-soft)}
.res small{color:var(--sp-muted)}
.list{flex:1;overflow:auto;display:flex;flex-direction:column;gap:8px}
.ent{padding:10px 12px;display:grid;grid-template-columns:auto 1fr auto;gap:8px 12px;align-items:center}
.ent.sent{background:hsl(142 60% 45% / .1);border-color:hsl(142 60% 40% / .3)}
.ent .nm b{font-weight:500;display:block}.ent .nm small{color:var(--sp-muted)}
.ent .ctl{display:flex;gap:8px;grid-column:1/4;flex-wrap:wrap;align-items:flex-end}
.ent .send{margin-left:auto;padding:9px 14px}
.ent.sent .send{background:hsl(142 60% 38%)}
.ent .more{border:0;background:transparent;color:var(--sp-muted);padding:4px}
.info{grid-column:1/4;font-size:calc(var(--sp-ui)*.9);color:var(--sp-muted);display:flex;flex-direction:column;gap:8px}
.info .btn{align-self:flex-start;padding:6px 10px}
.hint{margin:auto;text-align:center;color:var(--sp-muted);padding:24px}
.ph{display:flex;align-items:center;gap:8px}.ph h3{margin:0;font:600 calc(var(--sp-ui)*1.05) var(--sp-sans)}.ph small{color:var(--sp-muted)}
.badge{min-width:18px;height:18px;border-radius:9px;background:#ff3b30;color:#fff;font-size:11px;display:inline-grid;place-items:center;padding:0 5px}
.tl{flex:1;overflow:auto;display:flex;flex-direction:column;gap:8px}
.tile{display:flex;gap:10px;padding:10px 12px;border-radius:calc(var(--sp-r) - 2px);background:hsl(142 60% 45% / .14);border:.5px solid hsl(142 60% 40% / .3);animation:pop .4s cubic-bezier(.2,.8,.3,1)}
.tile .t{font:500 calc(var(--sp-ui)*.8) var(--sp-serif);color:var(--sp-muted);min-width:40px;padding-top:2px}
.tile b{font-weight:500;display:block}.tile small{color:var(--sp-muted)}
.tile .ck{margin-left:auto;color:hsl(142 60% 32%);font-weight:700}
@keyframes pop{from{transform:translateY(-8px) scale(.97);opacity:0}to{transform:none;opacity:1}}
.toast{position:absolute;top:14px;right:14px;z-index:20;max-width:300px;display:flex;gap:10px;align-items:center;padding:10px 14px;border-radius:16px;background:var(--sp-glass-bg);backdrop-filter:blur(28px) saturate(200%);box-shadow:0 12px 40px rgba(0,0,0,.2),0 0 0 .5px var(--sp-line);animation:ti .3s cubic-bezier(.2,.7,.3,1)}
.toast.out{opacity:0;transform:translateX(18px);transition:all .3s}
.toast .ic{width:30px;height:30px;border-radius:8px;background:var(--sp-accent);color:#fff;display:grid;place-items:center;font-size:15px}
.toast small{color:var(--sp-muted);display:block}
@keyframes ti{from{opacity:0;transform:translateX(18px) scale(.97)}to{opacity:1;transform:none}}
.mob .toast{left:12px;right:12px;max-width:none;top:calc(10px + env(safe-area-inset-top))}
</style>
<body><script src="exercises.js"></script><script src="sport-shared.js"></script><script>
const {h,thumb,stepper,grep,forDay,addEntry,patchEntry,dropEntry,lastOf,fmt,byId,today} = SPORT;
const st = { q: '', tab: 'sport', info: null, toast: null };
const hhmm = () => new Date().toTimeString().slice(0, 5);
// « Sending to Plan » = marking the entry as sent; the Plan column is derived from sent entries (mock of a Plan task write).
// FR : « envoyer à Plan » = marquer l'entrée envoyée ; la colonne Plan se déduit des entrées envoyées (maquette d'une écriture de tâche Plan).
const toast = (main, title, sub) => { st.toast = { title, sub }; showToast(main); };
const showToast = main => { main.querySelector('.toast')?.remove(); if (!st.toast) return;
  const t = h('div', { class: 'toast' }, h('div', { class: 'ic' }, '▦'), h('div', {}, h('b', {}, st.toast.title), h('small', {}, st.toast.sub)));
  main.append(t); clearTimeout(st.tt); st.tt = setTimeout(() => { t.classList.add('out'); setTimeout(() => { t.remove(); st.toast = null; }, 320); }, 3200); };
SPORT.boot((main, ctx) => {
  const R = ctx.rerender, mob = ctx.mobile, day = forDay(today()), sent = day.filter(e => e.sent).sort((a, b) => (a.time || '').localeCompare(b.time || ''));
  const summary = e => `${e.sets} × ${e.reps}${e.kg ? ` · ${e.kg} kg` : ''}`;
  // ---- Sport column
  const res = h('div', { class: 'res' }); let hl = 0;
  const pick = ex => { addEntry(ex.id, today()); st.q = ''; R(); };
  const fillRes = () => { const r = st.q ? grep(st.q, 'Tous').slice(0, 6) : []; res.replaceChildren(...r.map((ex, i) => h('button', { class: i === hl ? 'hl' : '', onclick: () => pick(ex) }, thumb(ex, '34px'), h('span', {}, ex.name, h('br'), h('small', {}, ex.group)))));
    res.style.display = r.length ? '' : 'none'; return r; };
  const input = h('input', { placeholder: 'Ajouter un exercice (tape : épaules, tractions…)', value: st.q, oninput: e => { st.q = e.target.value; hl = 0; fillRes(); },
    onkeydown: e => { const r = fillRes(); if (e.key === 'ArrowDown') { hl = Math.min(hl + 1, r.length - 1); fillRes(); } if (e.key === 'ArrowUp') { hl = Math.max(hl - 1, 0); fillRes(); } if (e.key === 'Enter' && r[hl]) pick(r[hl]); } });
  fillRes();
  const row = e => { const ex = byId(e.ex), v = {};
    const send = h('button', { class: 'btn send', onclick: () => { if (e.sent) { patchEntry(e.id, { sent: false }); toast(main, 'Plan', `Tâche retirée : ${ex.name}`); }
      else { patchEntry(e.id, { sent: true, time: hhmm() }); toast(main, 'Plan · tâche ajoutée', `Sport · ${ex.name} ${e.sets} × ${e.reps}`); } R(); } }, e.sent ? '✓ Dans Plan' : 'Envoyer à Plan');
    const upd = p => { patchEntry(e.id, p); if (e.sent) { const t = main.querySelector(`[data-t="${e.id}"] small`); if (t) t.textContent = summary({ ...e, ...p }); } };
    return h('div', { class: 'card ent' + (e.sent ? ' sent' : '') }, thumb(ex, '44px'), h('div', { class: 'nm' }, h('b', {}, ex.name), h('small', {}, ex.group)),
      h('button', { class: 'more', title: 'Description et prompt image', onclick: () => { st.info = st.info === e.id ? null : e.id; R(); } }, 'ⓘ'),
      h('div', { class: 'ctl' }, stepper({ label: 'Séries', value: e.sets, min: 1, onChange: x => { e.sets = x; upd({ sets: x }); } }), stepper({ label: 'Reps', value: e.reps, min: 1, onChange: x => { e.reps = x; upd({ reps: x }); } }), stepper({ label: 'kg', value: e.kg, step: 2.5, onChange: x => { e.kg = x; upd({ kg: x }); } }), send),
      st.info === e.id && h('div', { class: 'info' }, h('span', {}, ex.desc), h('button', { class: 'btn ghost', onclick: ev => { navigator.clipboard?.writeText(ex.prompt); ev.target.textContent = 'Copié ✓'; } }, 'Copier le prompt image')));
  };
  const sport = h('section', { class: 'sport' }, h('div', { class: 'top', style: 'padding:16px 0 4px' }, h('h1', {}, 'Sport'), h('div', { class: 'sp' }), h('span', { class: 'auto' }, `${SPORT.weekday(today())} · ${fmt(today())}`)),
    h('div', { class: 'find' }, h('div', { class: 'search-in' }, '⌕', input), res),
    h('div', { class: 'list' }, day.length ? day.map(row) : h('div', { class: 'hint' }, 'Aucun exercice aujourd\'hui.', h('br'), 'Cherche-en un ci-dessus : il se règle en un tap, et « Envoyer à Plan » le coche dans ton calendrier.')));
  // ---- Plan column (preview of what Plan receives)
  const plan = h('section', { class: 'plan' }, h('div', { class: 'ph' }, h('h3', {}, 'Plan'), h('small', {}, `Today · ${fmt(today())}`), h('div', { class: 'sp', style: 'flex:1' }), sent.length > 0 && h('span', { class: 'badge num' }, sent.length)),
    h('div', { class: 'tl' }, sent.length ? sent.map(e => h('div', { class: 'tile', 'data-t': e.id }, h('span', { class: 't' }, e.time), h('div', {}, h('b', {}, `Sport · ${byId(e.ex).name}`), h('small', {}, summary(e))), h('span', { class: 'ck' }, '✓')))
      : h('div', { class: 'hint' }, 'Rien d\'envoyé pour l\'instant.', h('br'), 'Chaque exercice envoyé apparaît ici comme une tâche faite.')));
  if (mob) main.append(h('div', { class: 'cols', style: 'flex-direction:column' }, st.tab === 'sport' ? sport : plan),
    h('div', { class: 'tabbar' }, h('button', { class: st.tab === 'sport' ? 'on' : '', onclick: () => { st.tab = 'sport'; R(); } }, h('span', {}, '☰'), 'Sport'),
      h('button', { class: st.tab === 'plan' ? 'on' : '', onclick: () => { st.tab = 'plan'; R(); } }, h('span', {}, '▦', sent.length > 0 && h('span', { class: 'badge num', style: 'margin-left:4px' }, sent.length)), 'Plan')));
  else main.append(h('div', { class: 'cols' }, sport, plan));
  showToast(main);
});
</script></body></html>
