<!doctype html>
<html lang="fr"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sport E Ligne</title>
<link rel="stylesheet" href="sport-shared.css">
<style>
/* E: one line to type, Enter logs and sends to Plan. 16 October 2026 */
.big-in{display:flex;align-items:center;gap:10px;padding:0 16px;min-height:56px;border-radius:calc(var(--sp-r) + 4px);background:var(--sp-bg);border:1.5px solid var(--sp-accent);box-shadow:0 0 0 4px var(--sp-accent-soft)}
.big-in input{flex:1;border:0;outline:0;background:transparent;font-size:calc(var(--sp-ui)*1.3);min-width:0}
.prev{display:flex;align-items:center;gap:12px;padding:10px 12px;color:var(--sp-muted)}
.prev b{color:var(--sp-fg);font-weight:500;display:block}.prev .go{margin-left:auto;font-size:calc(var(--sp-ui)*.85);white-space:nowrap}
.alts{display:flex;gap:6px;flex-wrap:wrap}
.redo{display:flex;gap:8px;overflow:auto;padding-bottom:2px}
.redo button{flex:none;display:flex;gap:8px;align-items:center;padding:5px 12px 5px 5px;border-radius:999px;border:.5px solid var(--sp-line);background:transparent}
.feed{flex:1;overflow:auto;display:flex;flex-direction:column;gap:6px}
.ln{display:grid;grid-template-columns:40px auto 1fr auto auto;align-items:center;gap:10px;padding:8px 10px;border-radius:calc(var(--sp-r) - 3px)}
.ln:hover{background:rgba(128,128,128,.07)}
.ln .tm{font:400 calc(var(--sp-ui)*.8) var(--sp-serif);color:var(--sp-muted)}
.ln .ok{color:hsl(142 60% 32%);font-size:calc(var(--sp-ui)*.85)}
.ln .info{grid-column:2/6}
.ln button.x{padding:2px 6px}
.ln .nm{cursor:pointer;min-width:0}.ln .nm small{color:var(--sp-muted);display:block}
</style>
<body><script src="exercises.js"></script><script src="sport-shared.js"></script><script>
const {h,thumb,grep,forDay,addEntry,patchEntry,dropEntry,byId,today,load,fmt,notify,autoSend,refreshPlan,summary,infoBlock,twoPane,lastOf} = SPORT;
const st = { q: '', hl: 0, edit: null, info: null, tab: 'sport' };
// "tractions 3x6 8kg" -> { query, sets, reps, kg }. FR : « tractions 3x6 8kg » devient requête + séries + reps + kg.
const parse = text => { let q = text, sets, reps, kg; let m;
  if ((m = q.match(/(\d+)\s*[x×*]\s*(\d+)/i))) { sets = +m[1]; reps = +m[2]; q = q.replace(m[0], ' '); }
  if ((m = q.match(/(\d+(?:[.,]\d+)?)\s*kg/i))) { kg = +m[1].replace(',', '.'); q = q.replace(m[0], ' '); }
  return { query: q.trim(), sets, reps, kg }; };
SPORT.boot((main, ctx) => {
  const R = ctx.rerender, day = forDay(today()).sort((a, b) => (a.time || 'zz').localeCompare(b.time || 'zz'));
  const p = parse(st.q), found = p.query ? grep(p.query, 'Tous') : [], ex = found[Math.min(st.hl, found.length - 1)];
  const val = ex && { sets: p.sets ?? ex.sets, reps: p.reps ?? ex.reps, kg: p.kg ?? ex.kg };
  const commit = () => { if (!ex) return; let id = st.edit;
    if (id) patchEntry(id, val); else id = addEntry(ex.id, today(), val).id;
    st.q = ''; st.edit = null; st.hl = 0; autoSend(main, id); R2(); };
  const R2 = () => { const keep = main.querySelector('.toast'); R(); if (keep) main.append(keep); };
  const input = h('input', { placeholder: 'tractions 3x6    ·    élév 4x15 6kg', value: st.q, autofocus: true,
    oninput: e => { st.q = e.target.value; st.hl = 0; R(); const i = main.querySelector('.big-in input'); i.focus(); i.setSelectionRange(99, 99); },
    onkeydown: e => { if (e.key === 'Enter') commit(); if (e.key === 'ArrowDown') { st.hl = Math.min(st.hl + 1, found.length - 1); R(); main.querySelector('.big-in input').focus(); } if (e.key === 'ArrowUp') { st.hl = Math.max(st.hl - 1, 0); R(); main.querySelector('.big-in input').focus(); } } });
  const preview = ex ? h('div', { class: 'card prev' }, thumb(ex, '48px'), h('div', {}, h('b', {}, ex.name), `${val.sets} × ${val.reps}${val.kg ? ` · ${val.kg} kg` : ''}`), h('span', { class: 'go' }, st.edit ? 'Entrée : mettre à jour' : 'Entrée : enregistrer et envoyer à Plan'))
    : st.q ? h('div', { class: 'prev' }, 'Aucun exercice ne correspond.') : null;
  const alts = found.length > 1 && h('div', { class: 'alts' }, found.slice(0, 4).map((f, i) => h('button', { class: 'chip' + (i === st.hl ? ' on' : ''), onclick: () => { st.hl = i; R(); } }, f.name)));
  const recent = [...new Set(load().sort((a, b) => b.date.localeCompare(a.date)).map(e => e.ex))].slice(0, 5);
  const redo = h('div', { class: 'redo' }, recent.map(id => { const e = byId(id), l = lastOf(id);
    return h('button', { onclick: () => { const n = addEntry(id, today(), { sets: l.sets, reps: l.reps, kg: l.kg }); autoSend(main, n.id); R2(); } }, thumb(e, '28px'), h('span', {}, e.name, h('small', { style: 'color:var(--sp-muted);margin-left:6px' }, `${l.sets}×${l.reps}`))) }));
  const feed = h('div', { class: 'feed' }, day.length ? day.map(e => { const x = byId(e.ex);
    return h('div', { class: 'ln' }, h('span', { class: 'tm' }, e.time || ''), h('div', { onclick: () => { st.info = st.info === e.id ? null : e.id; R2(); } }, thumb(x, '34px')),
      h('div', { class: 'nm', title: 'Modifier', onclick: () => { st.edit = e.id; st.q = `${x.name} ${e.sets}x${e.reps}${e.kg ? ` ${e.kg}kg` : ''}`; R(); main.querySelector('.big-in input').focus(); } }, x.name, h('small', {}, summary(e))),
      e.sent ? h('span', { class: 'ok' }, '✓ Plan') : h('span'), h('button', { class: 'x', onclick: () => { dropEntry(e.id); if (e.sent) notify(main, 'Plan', `Tâche retirée : ${x.name}`); refreshPlan(main); R2(); } }, '×'),
      st.info === e.id && infoBlock(x)); }) : h('div', { class: 'hint' }, "Rien aujourd'hui.", h('br'), 'Tape une ligne ci-dessus, par exemple : tractions 3x6'));
  const sport = h('section', { class: 'sportc' }, h('div', { class: 'top', style: 'padding:16px 0 0' }, h('h1', {}, 'Sport'), h('div', { class: 'sp' }), h('span', { class: 'auto' }, `${SPORT.weekday(today())} · ${fmt(today())}`)),
    h('div', { class: 'big-in' }, '⌕', input), alts, preview, !st.q && redo, feed);
  twoPane(main, ctx, sport, st);
});
</script></body></html>
