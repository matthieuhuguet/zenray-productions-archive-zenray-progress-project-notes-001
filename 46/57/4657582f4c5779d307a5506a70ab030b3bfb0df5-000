  <!-- ========================================================================
       MOTEUR INTERACTIF (WebAudio Procédural + Waveform + Contrôles HDA)
       ======================================================================== -->
  <script>
    // 1. Génération des barres de waveform dans chaque carte Audio
    document.querySelectorAll('.waveform-box').forEach((box) => {
      const values = (box.getAttribute('data-bars') || '').split(',').map(Number);
      box.innerHTML = '';
      values.forEach((v, idx) => {
        const bar = document.createElement('span');
        bar.className = 'wave-bar' + (v >= 75 ? ' is-hot' : '');
        bar.style.height = Math.max(14, Math.min(100, v)) + '%';
        bar.addEventListener('mouseenter', () => {
          bar.style.height = Math.min(100, v + 14) + '%';
        });
        bar.addEventListener('mouseleave', () => {
          bar.style.height = Math.max(14, Math.min(100, v)) + '%';
        });
        box.appendChild(bar);
      });
    });

    // 2. Synthétiseur WebAudio temps réel (zéro dépendance externe)
    let audioCtx = null;
    let lastSoundId = 'lumiere';

    function getMacroVal(id, fallback) {
      const el = document.getElementById(id);
      return el ? parseFloat(el.value) : fallback;
    }

    function playProceduralSound(soundId) {
      try {
        if (!audioCtx) {
          const AC = window.AudioContext || window.webkitAudioContext;
          audioCtx = new AC();
        }
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const now = audioCtx.currentTime;
        const pitch = getMacroVal('sfx-pitch', 1.0);
        const attack = getMacroVal('sfx-attack', 0.008);
        const tail = getMacroVal('sfx-tail', 1.2);
        const bright = getMacroVal('sfx-bright', 1.2);

        const presets = {
          lumiere: { freqs: [277.18, 329.63, 415.30, 622.25], type: 'triangle', dur: 1.5 },
          chest:   { freqs: [58.0, 174.61, 523.25, 1046.5, 1567.98], type: 'sine', dur: 1.4 },
          aerith:  { freqs: [293.66, 369.99, 440.0, 587.33, 880.0], type: 'sine', dur: 1.6 },
          totk:    { freqs: [523.25, 783.99, 1174.66], type: 'triangle', dur: 0.55 },
          chiral:  { freqs: [420.0, 840.0, 1680.0], type: 'sawtooth', dur: 0.7 },
          bayou:   { freqs: [110.0, 164.81, 220.0, 329.63], type: 'sine', dur: 1.5 },
          psflare: { freqs: [220.0, 329.63, 493.88, 659.25, 1318.5], type: 'sine', dur: 1.7 },
          subbass: { freqs: [65.41, 130.81, 196.0], type: 'sine', dur: 1.2 }
        };

        const p = presets[soundId] || presets.lumiere;
        p.freqs.forEach((f, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          const filter = audioCtx.createBiquadFilter();

          osc.type = p.type;
          osc.frequency.setValueAtTime(f * pitch, now + idx * 0.045);

          filter.type = 'lowpass';
          filter.frequency.setValueAtTime(1800 * bright, now);

          const startT = now + idx * 0.045;
          const totalDur = p.dur * tail;
          gain.gain.setValueAtTime(0.0001, startT);
          gain.gain.linearRampToValueAtTime(0.11 / Math.sqrt(idx + 1), startT + attack);
          gain.gain.exponentialRampToValueAtTime(0.0001, startT + totalDur);

          osc.connect(filter);
          filter.connect(gain);
          gain.connect(audioCtx.destination);

          osc.start(startT);
          osc.stop(startT + totalDur + 0.05);
        });
      } catch (e) {
        // Silencieux en rendu headless
      }
    }

    function playAudioCard(cardEl, soundId, title, meta) {
      lastSoundId = soundId;
      document.querySelectorAll('#section-audio .zr-card').forEach(c => c.classList.remove('is-playing'));
      if (cardEl && cardEl.classList.contains('zr-card')) {
        cardEl.classList.add('is-playing');
      }
      document.getElementById('dock-track-title').textContent = title;
      document.getElementById('dock-track-meta').textContent = meta + ' · Lecture WebAudio active';
      playProceduralSound(soundId);
    }

    function replayLastSound() {
      playProceduralSound(lastSoundId);
    }

    // 3. Commutation des vues et propositions
    let currentAppView = 'both';
    let currentAudioProp = 'A';
    let currentFontsProp = 'A';
    let currentRegime = 'adobe-clean';

    function setAppView(view) {
      currentAppView = view;
      document.querySelectorAll('[data-app-view]').forEach(btn => {
        btn.classList.toggle('is-active', btn.getAttribute('data-app-view') === view);
      });
      document.getElementById('section-audio').classList.toggle('is-hidden', view === 'fonts');
      document.getElementById('section-fonts').classList.toggle('is-hidden', view === 'audio');
      updateDockPill();
    }

    function selectAudioProp(prop) {
      currentAudioProp = prop;
      if (currentAppView === 'fonts') setAppView('both');
      ['A', 'B', 'C'].forEach(p => {
        const el = document.getElementById('audio-view-' + p);
        if (el) el.classList.toggle('is-hidden', p !== prop);
      });
      document.querySelectorAll('[data-audio-prop]').forEach(btn => {
        btn.classList.toggle('is-active', btn.getAttribute('data-audio-prop') === prop);
      });
      updateDockPill();
    }

    function selectFontsProp(prop) {
      currentFontsProp = prop;
      if (currentAppView === 'audio') setAppView('both');
      ['A', 'B', 'C'].forEach(p => {
        const el = document.getElementById('fonts-view-' + p);
        if (el) el.classList.toggle('is-hidden', p !== prop);
      });
      document.querySelectorAll('[data-fonts-prop]').forEach(btn => {
        btn.classList.toggle('is-active', btn.getAttribute('data-fonts-prop') === prop);
      });
      updateDockPill();
    }

    function setFontRegime(regime) {
      currentRegime = regime;
      document.documentElement.setAttribute('data-font-regime', regime);
      document.querySelectorAll('[data-regime-btn]').forEach(btn => {
        btn.classList.toggle('is-active', btn.getAttribute('data-regime-btn') === regime);
      });
      const labels = {
        'adobe-clean': 'Adobe Clean (2 Apps)',
        'adobe-gt-ultra': 'Adobe Clean + GT Ultra',
        'multi-fonts': 'Multi-Fonts Créateur'
      };
      document.getElementById('sb-regime-label').textContent = labels[regime];
      document.getElementById('dock-regime-pill').textContent = 'Régime : ' + labels[regime];
    }

    function updateDockPill() {
      document.getElementById('dock-prop-pill').textContent =
        'Audio Prop. ' + currentAudioProp + ' + Fonts Prop. ' + currentFontsProp;
    }

    // 4. Filtres et recherche Audio
    function filterAudioCards(kind, btnEl) {
      document.querySelectorAll('[data-audio-filter]').forEach(b => b.classList.remove('is-audio-active'));
      if (btnEl) btnEl.classList.add('is-audio-active');
      document.querySelectorAll('#audio-view-A .zr-card').forEach(card => {
        const match = (kind === 'all') || (card.getAttribute('data-kind') === kind);
        card.classList.toggle('is-hidden', !match);
      });
    }

    function searchAudioCards(q) {
      const term = (q || '').trim().toLowerCase();
      document.querySelectorAll('#audio-view-A .zr-card').forEach(card => {
        const txt = card.textContent.toLowerCase();
        card.classList.toggle('is-hidden', term && !txt.includes(term));
      });
    }

    // 5. Aperçu Dialogue Jeu Vidéo & Rayons X Fonts
    const dialogueFonts = [
      { css: 'var(--font-chiaro)', label: 'FOT-Chiaro Std B (Zelda OoT / TOTK + CJK)' },
      { css: 'var(--font-adobe)', label: 'Adobe Clean (UI & Sous-titres modernes)' },
      { css: 'var(--font-gt-ultra)', label: 'GT Ultra Regular 400 (Titres & Narration)' },
      { css: 'var(--font-literata)', label: 'Literata (Journaux de quête & Lore)' },
      { css: 'var(--font-beaufort)', label: 'Beaufort for LOL Bold (Boss & Cinématique)' }
    ];
    let dialogueIdx = 0;

    function previewFontInDialogue(fontCss, labelText) {
      document.documentElement.style.setProperty('--preview-game-font', fontCss);
      document.getElementById('dialogue-font-label').textContent = 'Aperçu Dialogue Jeu Vidéo · ' + labelText;
    }

    function cycleDialogueFont() {
      dialogueIdx = (dialogueIdx + 1) % dialogueFonts.length;
      const item = dialogueFonts[dialogueIdx];
      previewFontInDialogue(item.css, item.label);
    }

    function toggleXrayGuides() {
      document.querySelectorAll('.font-stage').forEach(st => st.classList.toggle('has-xray'));
    }

    // 6. Contrôles HDA (:root variables, Thème & Copie pour le prompt)
    function setHdaVar(varName, val, labelId) {
      document.documentElement.style.setProperty(varName, val);
      const lbl = document.getElementById(labelId);
      if (lbl) lbl.textContent = val;
    }

    function toggleTheme() {
      const root = document.documentElement;
      const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      document.getElementById('theme-toggle-btn').textContent = 'Thème : ' + (next === 'dark' ? 'Dark' : 'Light');
    }

    function copyHdaChoice() {
      const style = getComputedStyle(document.documentElement);
      const payload = [
        'Choix Design Gallery Audio & Fonts :',
        '- Audio Proposition : ' + currentAudioProp,
        '- Fonts Proposition : ' + currentFontsProp,
        '- Régime Typographique : ' + currentRegime,
        '- Thème : ' + document.documentElement.getAttribute('data-theme'),
        '- --gal-cols : ' + style.getPropertyValue('--gal-cols').trim(),
        '- --gal-gap : ' + style.getPropertyValue('--gal-gap').trim(),
        '- --gal-radius : ' + style.getPropertyValue('--gal-radius').trim(),
        '- --spec-size : ' + style.getPropertyValue('--spec-size').trim()
      ].join('\n');

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(payload);
      }
      const btn = document.getElementById('copy-hda-btn');
      btn.textContent = 'Copié pour le prompt ✓';
      setTimeout(() => { btn.textContent = 'Copier mon choix & HDA'; }, 1800);
    }
  </script>
