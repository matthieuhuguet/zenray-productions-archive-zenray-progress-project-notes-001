  .card-title-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 15px;
    color: var(--ink-primary);
    letter-spacing: -0.01em;
  }

  .card-dur {
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    font-size: 11.5px;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .card-meta {
    font-size: 12px;
    color: var(--ink-secondary);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .macro-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: auto;
    padding-top: 4px;
  }

  .macro-pill {
    font-size: 10.5px;
    padding: 2px 7px;
    border-radius: 6px;
    background: var(--bg-elevated);
    color: var(--ink-secondary);
    border: 1px solid var(--line-subtle);
  }

  .macro-pill strong {
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    color: var(--ink-primary);
  }

  /* ==========================================================================
     8. GALLERY AUDIO · PROPOSITION B : « GAME AUDIO MATRIX & STEM DECK »
     ========================================================================== */
  .stem-deck-layout {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 16px;
  }

  .bgm-banner-stack {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bgm-banner {
    background: var(--bg-card);
    border: 1px solid var(--line-subtle);
    border-radius: var(--gal-radius);
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    cursor: pointer;
    transition: border-color 0.16s ease;
  }

  .bgm-banner:hover {
    border-color: var(--accent-audio);
  }

  .bgm-cue-bar {
    height: 28px;
    background: var(--bg-elevated);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 0 10px;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ink-secondary);
    border: 1px solid var(--line-subtle);
  }

  .bgm-cue-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 68%;
    background: linear-gradient(90deg, rgba(232, 155, 76, 0.25), rgba(99, 150, 255, 0.22));
    pointer-events: none;
  }

  .sfx-pad-matrix {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .sfx-pad {
    background: var(--bg-card);
    border: 1px solid var(--line-subtle);
    border-radius: var(--gal-radius);
    padding: 13px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sfx-pad:hover {
    border-color: var(--accent-emerald);
    transform: translateY(-1px);
  }

  /* ==========================================================================
     9. GALLERY AUDIO · PROPOSITION C : « OSCILLOSCOPE & INSPECTEUR HDA »
     ========================================================================== */
  .osc-inspector-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
    gap: 16px;
  }

  .hda-node-inspector {
    background: var(--bg-card);
    border: 1px solid var(--line-strong);
    border-radius: var(--gal-radius);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .hda-param-row {
    display: grid;
    grid-template-columns: 92px 1fr 44px;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }

  .hda-param-row input[type="range"] {
    width: 100%;
    accent-color: var(--accent-audio);
  }

  /* ==========================================================================
     10. GALLERY FONTS · PROPOSITION A : « FOUNDRY SPECIMEN & GAME DIALOGUE »
     ========================================================================== */
  .font-stage {
    position: relative;
    padding: 16px 16px 14px;
    min-height: 168px;
    border-bottom: 1px solid var(--line-subtle);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: radial-gradient(circle at 86% 16%, rgba(99, 150, 255, 0.13), transparent 65%);
  }

  .font-stage.has-xray .font-specimen-big {
    border-bottom: 1.5px solid var(--accent-laser);
    border-top: 1px dashed rgba(99, 150, 255, 0.45);
    position: relative;
  }

  .font-specimen-big {
    font-size: var(--spec-size);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink-primary);
    margin: 10px 0 8px;
    outline: none;
    word-break: break-word;
  }

  .font-sample-line {
    font-size: 13px;
    color: var(--ink-secondary);
    line-height: 1.4;
    outline: none;
  }

  .weight-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .weight-pill {
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--bg-elevated);
    color: var(--ink-secondary);
    border: 1px solid var(--line-subtle);
  }

  .weight-pill.is-active {
    background: var(--accent-fonts-soft);
    color: var(--accent-fonts);
    border-color: rgba(99, 150, 255, 0.35);
  }

  /* Aperçu Boîte de Dialogue Zelda / Jeu Vidéo en direct */
  .game-dialogue-preview {
    background: linear-gradient(180deg, rgba(16, 20, 28, 0.94), rgba(10, 12, 18, 0.97));
    border: 1px solid rgba(232, 198, 118, 0.42);
    border-radius: 16px;
    padding: 16px 20px;
    color: #f7f4eb;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .game-dialogue-speaker {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #e8c676;
    margin-bottom: 4px;
    font-weight: 700;
  }

  .game-dialogue-text {
    font-family: var(--preview-game-font, var(--font-chiaro));
    font-size: 19px;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }

  /* ==========================================================================
     11. GALLERY FONTS · PROPOSITION B & C : « RAYONS X CJK & MATRICE RÉGIMES »
     ========================================================================== */
  .cjk-xray-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .cjk-cell {
    background: var(--bg-card);
    border: 1px solid var(--line-subtle);
    border-radius: var(--gal-radius);
    padding: 16px;
    text-align: center;
    position: relative;
  }

  .cjk-glyph {
    font-size: 64px;
    line-height: 1.1;
    border-bottom: 1.5px solid var(--accent-laser);
    display: inline-block;
    padding: 0 12px 4px;
    margin-bottom: 8px;
  }

  .regime-compare-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .regime-card {
    background: var(--bg-card);
    border: 1px solid var(--line-subtle);
    border-radius: var(--gal-radius);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .regime-card.is-selected {
    border-color: var(--accent-fonts);
    box-shadow: 0 0 0 1px var(--accent-fonts);
  }

  /* ==========================================================================
     12. DOCK AUDIO & TYPO FLOTTANT EN BAS
     ========================================================================== */
  .zr-bottom-dock {
    position: fixed;
    bottom: 14px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 130;
    width: min(1120px, calc(100vw - 36px));
    background: var(--bg-glass);
    backdrop-filter: blur(22px) saturate(160%);
    -webkit-backdrop-filter: blur(22px) saturate(160%);
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    padding: 10px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.45);
  }

  .dock-now-playing {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 240px;
  }

  .dock-meter {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }

  .is-hidden {
    display: none !important;
  }

  @media (max-width: 1180px) {
    .zr-shell { grid-template-columns: 1fr; }
    .zr-sidebar { position: static; }
    .stem-deck-layout, .osc-inspector-layout, .regime-compare-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
