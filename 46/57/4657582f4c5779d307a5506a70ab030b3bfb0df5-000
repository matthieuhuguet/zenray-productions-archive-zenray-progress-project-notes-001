<!DOCTYPE html>
<html lang="fr" data-theme="dark" data-font-regime="adobe-clean">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>ZenRay Progress · Galeries Audio (SFX / BGM) &amp; Fonts (Adobe Clean &amp; Multi-Fonts)</title>
<style>
  /* ==========================================================================
     1. WEBFONTS AUTHENTIQUES (Zéro déformation procédurale, font-synthesis: none)
     ========================================================================== */
  @font-face {
    font-family: 'Adobe Clean';
    src: local('Adobe Clean Regular'), local('AdobeClean-Regular'),
         url('../_shared/fonts/AdobeClean-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Adobe Clean';
    src: local('Adobe Clean Medium'), local('AdobeClean-Medium'),
         url('../_shared/fonts/AdobeClean-Medium.woff2') format('woff2');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Adobe Clean';
    src: local('Adobe Clean Bold'), local('AdobeClean-Bold'),
         url('../_shared/fonts/AdobeClean-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT Ultra';
    src: local('GT Ultra Regular'), local('GTUltra-Regular'),
         url('../_shared/fonts/GT-Ultra-Regular.woff2') format('woff2');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Literata';
    src: local('Literata Regular'), local('Literata-Regular'),
         url('../_shared/fonts/Literata-latin.woff2') format('woff2');
    font-weight: 300 800;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Literata';
    src: local('Literata Italic'), local('Literata-Italic'),
         url('../_shared/fonts/Literata-Italic-latin.woff2') format('woff2');
    font-weight: 300 800;
    font-style: italic;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT Sectra LCG';
    src: local('GT Sectra LCG Regular'),
         url('../_shared/fonts/GT-Sectra-LCGV-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT Standard L';
    src: local('GT Standard L Regular'),
         url('../_shared/fonts/GT-Standard-L-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT Standard L';
    src: local('GT Standard L Bold'),
         url('../_shared/fonts/GT-Standard-L-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'GT Planar';
    src: local('GT Planar Regular'), local('GTPlanar-Regular'),
         url('../_shared/fonts/GT-Planar-Regular.otf') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Beaufort for LOL';
    src: local('BeaufortforLOL-Bold'), local('Beaufort for LOL Bold'),
         url('../_shared/fonts/BeaufortforLOL-Bold.otf') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Vogun';
    src: local('Vogun Medium'), local('Vogun-Medium'),
         url('../_shared/fonts/Vogun-Medium.ttf') format('truetype');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Anthropic Mono';
    src: local('Anthropic Mono Regular'),
         url('../_shared/fonts/AnthropicMono-Regular.ttf') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'FOT-Chiaro Std B';
    src: local('FOT-ChiaroStd-B'), local('FOT-Chiaro Std B'), local('Hiragino Mincho ProN W6');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  /* ==========================================================================
     2. PARAMÈTRES HDA (:root) & THÈMES DARK / LIGHT
     ========================================================================== */
  :root {
    --font-adobe: 'Adobe Clean', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-gt-ultra: 'GT Ultra', 'Adobe Clean', sans-serif;
    --font-literata: 'Literata', Georgia, serif;
    --font-sectra: 'GT Sectra LCG', Georgia, serif;
    --font-chiaro: 'FOT-Chiaro Std B', 'Literata', 'Hiragino Mincho ProN', serif;
    --font-beaufort: 'Beaufort for LOL', 'GT Ultra', serif;
    --font-vogun: 'Vogun', 'Literata', serif;
    --font-planar: 'GT Planar', 'Adobe Clean', sans-serif;
    --font-mono: 'Anthropic Mono', 'SF Mono', Menlo, monospace;

    /* Régime actif par défaut : 100% Adobe Clean */
    --font-ui: var(--font-adobe);
    --font-display: var(--font-adobe);
    --font-num: var(--font-adobe);
    --display-weight: 700;

    /* Paramètres HDA pilotables aux curseurs */
    --gal-cols: 4;
    --gal-gap: 16px;
    --gal-radius: 16px;
    --wave-height: 54px;
    --spec-size: 36px;
    --card-pad: 16px;

    /* Tokens Dark Mode (défaut ZenRayProgress) */
    --bg-app: #0d0e11;
    --bg-sidebar: rgba(20, 22, 26, 0.88);
    --bg-canvas: #131519;
    --bg-card: #191c22;
    --bg-card-hover: #20242c;
    --bg-elevated: #232730;
    --bg-glass: rgba(26, 29, 36, 0.78);
    --line-subtle: rgba(255, 255, 255, 0.07);
    --line-strong: rgba(255, 255, 255, 0.14);
    --ink-primary: #f4f5f8;
    --ink-secondary: #a2a8b4;
    --ink-muted: #6c7280;
    --accent-audio: #e89b4c;
    --accent-audio-soft: rgba(232, 155, 76, 0.14);
    --accent-fonts: #6396ff;
    --accent-fonts-soft: rgba(99, 150, 255, 0.14);
    --accent-emerald: #3ecf8e;
    --accent-emerald-soft: rgba(62, 207, 142, 0.14);
    --accent-laser: #ff5468;
    --shadow-card: 0 12px 32px rgba(0, 0, 0, 0.34);
  }

  html[data-theme="light"] {
    --bg-app: #f3f1ec;
    --bg-sidebar: rgba(246, 244, 238, 0.92);
    --bg-canvas: #faf8f4;
    --bg-card: #ffffff;
    --bg-card-hover: #f5f2eb;
    --bg-elevated: #edeae2;
    --bg-glass: rgba(255, 255, 255, 0.86);
    --line-subtle: rgba(20, 20, 19, 0.08);
    --line-strong: rgba(20, 20, 19, 0.16);
    --ink-primary: #151514;
    --ink-secondary: #575550;
    --ink-muted: #8a867e;
    --accent-audio: #c96f18;
    --accent-audio-soft: rgba(201, 111, 24, 0.11);
    --accent-fonts: #295be0;
    --accent-fonts-soft: rgba(41, 91, 224, 0.11);
    --accent-emerald: #168a56;
    --accent-emerald-soft: rgba(22, 138, 86, 0.11);
    --accent-laser: #d92d44;
    --shadow-card: 0 10px 26px rgba(20, 18, 14, 0.07);
  }

  /* Régimes typographiques commutables en 1 clic */
  html[data-font-regime="adobe-clean"] {
    --font-ui: var(--font-adobe);
    --font-display: var(--font-adobe);
    --font-num: var(--font-adobe);
    --display-weight: 700;
  }
  html[data-font-regime="adobe-gt-ultra"] {
    --font-ui: var(--font-adobe);
    --font-display: var(--font-gt-ultra);
    --font-num: var(--font-gt-ultra);
    --display-weight: 400;
  }
  html[data-font-regime="multi-fonts"] {
    --font-ui: var(--font-adobe);
    --font-display: var(--font-chiaro);
    --font-num: var(--font-mono);
    --display-weight: 700;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-synthesis: none;
    -webkit-font-smoothing: antialiased;
  }

  body {
    background: var(--bg-app);
    color: var(--ink-primary);
    font-family: var(--font-ui);
    font-size: 14px;
    line-height: 1.45;
    min-height: 100vh;
    overflow-x: hidden;
    transition: background 0.2s ease, color 0.2s ease;
  }

  /* ==========================================================================
     3. BARRE DE CONTRÔLE HDA (Sélecteur d'App, Propositions, Régimes & Curseurs)
     ========================================================================== */
  .hda-topbar {
    position: sticky;
    top: 0;
    z-index: 120;
    background: var(--bg-glass);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-bottom: 1px solid var(--line-subtle);
    padding: 8px 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .hda-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hda-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent-audio), var(--accent-fonts));
    box-shadow: 0 0 12px var(--accent-audio);
  }

  .hda-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 13px;
    letter-spacing: -0.01em;
  }

  .hda-pill-group {
    display: inline-flex;
    align-items: center;
    background: var(--bg-elevated);
    padding: 3px;
    border-radius: 10px;
    border: 1px solid var(--line-subtle);
    gap: 2px;
  }

  .hda-pill {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink-secondary);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    padding: 5px 10px;
    border-radius: 7px;
    cursor: pointer;
    transition: all 0.16s ease;
    white-space: nowrap;
  }

  .hda-pill:hover {
    color: var(--ink-primary);
  }

  .hda-pill.is-active {
    background: var(--bg-card);
    color: var(--ink-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
  }

  .hda-pill.is-audio.is-active {
    color: var(--accent-audio);
    border: 1px solid rgba(232, 155, 76, 0.35);
  }

  .hda-pill.is-fonts.is-active {
    color: var(--accent-fonts);
    border: 1px solid rgba(99, 150, 255, 0.35);
  }

  .hda-sliders {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hda-slider-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: var(--ink-secondary);
  }

  .hda-slider-item input[type="range"] {
    width: 68px;
    accent-color: var(--accent-audio);
    cursor: pointer;
  }

  .hda-val {
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    color: var(--ink-primary);
    min-width: 28px;
    font-variant-numeric: tabular-nums;
  }

  .hda-copy-btn {
    appearance: none;
    border: 1px solid var(--line-strong);
    background: var(--bg-card);
    color: var(--ink-primary);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .hda-copy-btn:hover {
    border-color: var(--accent-audio);
    color: var(--accent-audio);
  }

  /* ==========================================================================
     4. SHELL ZENRAY PROGRESS (Sidebar Liquid Glass 224px + Canvas Gallery)
     ========================================================================== */
  .zr-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 14px;
    padding: 14px 18px 96px;
    max-width: 1760px;
    margin: 0 auto;
  }

  .zr-sidebar {
    background: var(--bg-sidebar);
    border: 1px solid var(--line-subtle);
    border-radius: 22px;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: fit-content;
    position: sticky;
    top: 62px;
  }

  .zr-sb-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8px;
  }

  .zr-sb-brand {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 15px;
    letter-spacing: -0.02em;
  }

  .zr-sb-badge {
    font-size: 10.5px;
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--ink-secondary);
  }

  .zr-sb-group-title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    padding: 0 8px 4px;
  }

  .zr-sb-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .zr-sb-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: 10px;
    font-size: 13px;
    color: var(--ink-secondary);
    cursor: pointer;
    transition: all 0.15s ease;
    border: 1px solid transparent;
  }

  .zr-sb-item:hover {
    background: var(--bg-elevated);
    color: var(--ink-primary);
  }

  .zr-sb-item.is-active-audio {
    background: var(--accent-audio-soft);
    color: var(--accent-audio);
    border-color: rgba(232, 155, 76, 0.28);
    font-weight: 500;
  }

  .zr-sb-item.is-active-fonts {
    background: var(--accent-fonts-soft);
    color: var(--accent-fonts);
    border-color: rgba(99, 150, 255, 0.28);
    font-weight: 500;
  }

  .zr-sb-count {
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    font-size: 11px;
    opacity: 0.78;
    font-variant-numeric: tabular-nums;
  }

  /* ==========================================================================
     5. CANVAS PRINCIPAL (.zr-gallery-canvas)
     ========================================================================== */
  .zr-main {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .zr-section-block {
    background: var(--bg-canvas);
    border: 1px solid var(--line-subtle);
    border-radius: 24px;
    padding: 20px 22px 24px;
    box-shadow: var(--shadow-card);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .zr-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px;
    border-bottom: 1px solid var(--line-subtle);
    padding-bottom: 14px;
  }

  .zr-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 4px;
  }

  .zr-eyebrow.is-audio { color: var(--accent-audio); }
  .zr-eyebrow.is-fonts { color: var(--accent-fonts); }

  .zr-h1 {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 23px;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .zr-sub {
    color: var(--ink-secondary);
    font-size: 13px;
    margin-top: 3px;
  }

  .zr-prop-tabs {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--bg-elevated);
    padding: 4px;
    border-radius: 12px;
    border: 1px solid var(--line-subtle);
    flex-wrap: wrap;
  }

  .zr-prop-btn {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--ink-secondary);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    padding: 6px 12px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .zr-prop-btn:hover {
    color: var(--ink-primary);
  }

  .zr-prop-btn.is-active {
    background: var(--bg-card);
    color: var(--ink-primary);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  /* Barre de filtres rapides façon GalleryView */
  .zr-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .zr-chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .zr-chip {
    appearance: none;
    border: 1px solid var(--line-subtle);
    background: var(--bg-card);
    color: var(--ink-secondary);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 500;
    padding: 5px 11px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .zr-chip:hover,
  .zr-chip.is-active {
    color: var(--ink-primary);
    border-color: var(--line-strong);
    background: var(--bg-elevated);
  }

  .zr-chip.is-audio-active {
    background: var(--accent-audio-soft);
    color: var(--accent-audio);
    border-color: rgba(232, 155, 76, 0.36);
  }

  .zr-chip.is-fonts-active {
    background: var(--accent-fonts-soft);
    color: var(--accent-fonts);
    border-color: rgba(99, 150, 255, 0.36);
  }

  .zr-search-box {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-card);
    border: 1px solid var(--line-subtle);
    border-radius: 10px;
    padding: 5px 11px;
    min-width: 240px;
  }

  .zr-search-box input {
    border: 0;
    background: transparent;
    color: var(--ink-primary);
    font-family: var(--font-ui);
    font-size: 12.5px;
    width: 100%;
    outline: none;
  }

  /* ==========================================================================
     6. GRILLE DE CARTES UNIFIÉE (Pilotée par --gal-cols, --gal-gap, --gal-radius)
     ========================================================================== */
  .zr-grid {
    display: grid;
    grid-template-columns: repeat(var(--gal-cols), minmax(0, 1fr));
    gap: var(--gal-gap);
  }

  .zr-card {
    background: var(--bg-card);
    border: 1px solid var(--line-subtle);
    border-radius: var(--gal-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    cursor: pointer;
    position: relative;
  }

  .zr-card:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    background: var(--bg-card-hover);
  }

  .zr-card.is-playing {
    border-color: var(--accent-audio);
    box-shadow: 0 0 0 1px var(--accent-audio), var(--shadow-card);
  }

  /* ==========================================================================
     7. GALLERY AUDIO · PROPOSITION A : « SPECTRAL & WAVEFORM GALLERY »
     ========================================================================== */
  .audio-stage {
    position: relative;
    padding: 14px 14px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 158px;
    border-bottom: 1px solid var(--line-subtle);
    overflow: hidden;
  }

  .audio-stage::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.22;
    pointer-events: none;
    background: radial-gradient(circle at 82% 18%, var(--card-glow, #e89b4c), transparent 68%);
  }

  .audio-top-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .audio-kind-pill {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.36);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  html[data-theme="light"] .audio-kind-pill {
    background: rgba(20, 20, 19, 0.08);
    color: var(--ink-primary);
    border-color: rgba(20, 20, 19, 0.12);
  }

  .audio-tech-badges {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .tech-badge {
    font-family: var(--font-num);
    font-weight: var(--display-weight);
    font-size: 10.5px;
    padding: 2px 6px;
    border-radius: 5px;
    background: var(--bg-elevated);
    color: var(--ink-secondary);
    border: 1px solid var(--line-subtle);
    font-variant-numeric: tabular-nums;
  }

  .tech-badge.is-lufs {
    color: var(--accent-emerald);
    border-color: rgba(62, 207, 142, 0.28);
    background: var(--accent-emerald-soft);
  }

  /* Ruban Waveform / Spectrogramme interactif */
  .waveform-box {
    position: relative;
    z-index: 1;
    height: var(--wave-height);
    margin: 12px 0 8px;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    padding: 4px 2px;
  }

  .wave-bar {
    flex: 1;
    border-radius: 99px;
    background: var(--ink-muted);
    opacity: 0.42;
    transition: height 0.18s ease, background 0.15s ease, opacity 0.15s ease;
    min-height: 14%;
  }

  .zr-card:hover .wave-bar {
    opacity: 0.72;
  }

  .wave-bar.is-hot {
    background: var(--card-glow, var(--accent-audio));
    opacity: 0.95;
  }

  .audio-stage-bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    color: var(--ink-secondary);
  }

  .play-orb {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    background: var(--ink-primary);
    color: var(--bg-card);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    transition: transform 0.15s ease, background 0.15s ease;
