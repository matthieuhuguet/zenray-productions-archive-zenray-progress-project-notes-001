.zr-video-options-pill { display: inline-flex; box-sizing: border-box; align-items: center; gap: 4px; height: 44px; padding: 2px 6px; border-radius: 999px; overflow: hidden; }
.zr-video-option-button { display: inline-grid; width: 40px; height: 40px; place-items: center; flex: 0 0 auto; padding: 0; color: rgba(255, 255, 255, 0.8); border: 0; border-radius: 999px; background: transparent; cursor: pointer; transition: background-color 0.2s ease, color 0.2s ease; }
.zr-video-settings-menu { position: absolute; right: 0; bottom: 52px; min-width: 165px; max-height: 320px; overflow: auto; padding: 8px; color: #ffffff !important; border-radius: 16px; background: rgba(14, 15, 18, 0.82); border: 1px solid rgba(255, 255, 255, 0.18); box-shadow: 0 16px 44px rgba(0, 0, 0, 0.55); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); z-index: 40; }
.zr-video-settings-menu .zr-ctrl-btn,
