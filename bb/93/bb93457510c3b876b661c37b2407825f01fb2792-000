<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ZenRay Progress — Rework Vue Galerie (3 Propositions)</title>
  <style>
    @font-face {
      font-family: 'GT Ultra';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/GT-Ultra-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'GT Standard L';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/GT-Standard-L-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'GT Standard L';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/GT-Standard-L-Bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Literata';
      src: url('file:///Users/zenray/.claude/skills/zenray-edit/designs/_shared/fonts/Literata-latin.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    :root {
      --font-title: 'GT Ultra', -apple-system, sans-serif;
      --font-num: 'GT Ultra', -apple-system, sans-serif;
      --font-body: 'Literata', Georgia, serif;
      --font-ui: 'GT Standard L', -apple-system, sans-serif;

      --bg: #121214;
      --surface: #1c1c20;
      --surface-subtle: #24242a;
      --border: rgba(255, 255, 255, 0.08);
      --ink: #f4f4f6;
      --muted: #9a9aa2;
      --accent: #3b82f6;
      --accent-soft: rgba(59, 130, 246, 0.16);
      --letterbox: rgba(255, 255, 255, 0.03);

      /* Paramètres réglables par sliders */
      --gal-cols: 4;
      --gal-gap: 18px;
      --gal-radius: 8px;
      --gal-ratio: 4 / 3;
      --gal-fit: cover;
      --halo-opacity: 0.35;
    }

    [data-theme="light"] {
      --bg: #f7f7f9;
      --surface: #ffffff;
      --surface-subtle: #f0f0f3;
      --border: rgba(0, 0, 0, 0.08);
      --ink: #16161a;
      --muted: #6e6e76;
      --accent: #2563eb;
      --accent-soft: rgba(37, 99, 235, 0.12);
      --letterbox: rgba(0, 0, 0, 0.03);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: 15px;
      line-height: 1.5;
      padding-bottom: 90px;
      transition: background 0.2s ease, color 0.2s ease;
      -webkit-font-smoothing: antialiased;
    }

    /* Utilitaires typographiques */
    .title, h1, h2, h3 { font-family: var(--font-title); font-weight: 400; letter-spacing: -0.015em; }
    .num { font-family: var(--font-num); font-variant-numeric: tabular-nums; font-weight: 400; }
    .ui, button, label, input, select, .badge { font-family: var(--font-ui); font-size: 13px; }

    /* Panneau Paramétrique Supérieur HDA */
    .control-deck {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(24, 24, 28, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      padding: 14px 28px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      box-shadow: 0 4px 24px rgba(0,0,0,0.25);
    }
    [data-theme="light"] .control-deck {
      background: rgba(255, 255, 255, 0.90);
    }

    .deck-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .propositions-tabs {
      display: inline-flex;
      background: var(--surface-subtle);
      padding: 3px;
      border-radius: 9px;
      border: 1px solid var(--border);
      gap: 3px;
    }

    .prop-tab {
      padding: 7px 15px;
      border-radius: 7px;
      border: 0;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.16s ease;
    }
    .prop-tab.active {
      background: var(--surface);
      color: var(--ink);
      box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    }
    .prop-tab .tab-idx {
      font-family: var(--font-num);
      font-size: 12px;
      opacity: 0.6;
    }

    .deck-sliders {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
      padding-top: 4px;
      font-family: var(--font-ui);
      font-size: 12px;
    }

    .slider-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .slider-group label {
      color: var(--muted);
      white-space: nowrap;
    }
    .slider-group .slider-val {
      font-family: var(--font-num);
      color: var(--ink);
      min-width: 28px;
      text-align: right;
    }
    .slider-group input[type="range"] {
      width: 90px;
      accent-color: var(--accent);
      cursor: pointer;
    }

    .select-pill {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--ink);
      padding: 4px 10px;
      border-radius: 6px;
      cursor: pointer;
    }

    .copy-btn, .theme-btn {
      background: var(--surface-subtle);
      border: 1px solid var(--border);
      color: var(--ink);
      padding: 7px 13px;
      border-radius: 7px;
      cursor: pointer;
      font-weight: 500;
      transition: background 0.15s ease;
    }
    .copy-btn:hover, .theme-btn:hover {
      background: var(--accent-soft);
      border-color: var(--accent);
    }

    /* Conteneur principal */
    .container {
      max-width: 1680px;
      margin: 0 auto;
      padding: 32px 36px;
    }

    /* En-tête de section */
    .view-hero {
      margin-bottom: 28px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      border-bottom: 1px solid var(--border);
      padding-bottom: 18px;
    }
    .view-hero h1 {
      font-size: 32px;
      color: var(--ink);
      line-height: 1.15;
    }
    .view-hero .subtitle {
      color: var(--muted);
      font-size: 14px;
      margin-top: 6px;
    }
    .hero-meta {
      display: flex;
      align-items: center;
      gap: 16px;
      color: var(--muted);
      font-family: var(--font-ui);
      font-size: 13px;
    }

    /* Grille principale paramétrique */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(var(--gal-cols), minmax(0, 1fr));
      gap: var(--gal-gap);
      align-items: start;
    }

    /* Tuiles génériques */
    .tile {
      position: relative;
      background: var(--surface);
      border-radius: var(--gal-radius);
      overflow: hidden;
      border: 1px solid var(--border);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s ease, border-color 0.2s ease;
    }
    .tile:hover {
      border-color: rgba(255, 255, 255, 0.18);
      box-shadow: 0 12px 32px rgba(0,0,0,0.30);
    }
    [data-theme="light"] .tile:hover {
      border-color: rgba(0, 0, 0, 0.15);
      box-shadow: 0 12px 32px rgba(0,0,0,0.10);
    }

    .media-box {
      width: 100%;
      aspect-ratio: var(--gal-ratio);
      background: var(--letterbox);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .media-box img, .media-box video {
      width: 100%;
      height: 100%;
      object-fit: var(--gal-fit);
      display: block;
      transition: transform 0.25s ease;
    }
    .tile:hover .media-box img, .tile:hover .media-box video {
      transform: scale(1.02);
    }

    /* Badges de format */
    .media-badge {
      position: absolute;
      bottom: 10px;
      right: 10px;
      padding: 3px 8px;
      background: rgba(14, 14, 18, 0.78);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      color: #fff;
      border-radius: 5px;
      font-family: var(--font-ui);
      font-weight: 700;
      font-size: 10px;
      letter-spacing: 0.05em;
      pointer-events: none;
      border: 1px solid rgba(255, 255, 255, 0.12);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .tile:hover .media-badge {
      opacity: 0.9;
    }

    .play-indicator {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.65);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
      backdrop-filter: blur(6px);
      pointer-events: none;
      transition: all 0.2s ease;
    }
    .tile.is-playing .play-indicator {
      background: var(--accent);
      transform: scale(0.9);
    }

    /* Légendes des tuiles */
    .caption {
      padding: 12px 14px 14px;
      background: var(--surface);
    }
    .caption-title {
      font-family: var(--font-title);
      font-size: 15px;
      color: var(--ink);
      line-height: 1.3;
      margin-bottom: 4px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .caption-note {
      font-family: var(--font-body);
      font-size: 13px;
      color: var(--muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .caption-meta {
      margin-top: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--font-ui);
      font-size: 11px;
      color: var(--muted);
    }

    /* ══════════════════════════════════════════════════════════
       SPÉCIFICITÉS DES 3 PROPOSITIONS
       ══════════════════════════════════════════════════════════ */

    /* PROPOSITION 1 : Ultra-Simple & Épurée */
    .prop-view[data-prop="1"] .gallery-grid {
      --gal-gap: 14px;
    }
    .prop-view[data-prop="1"] .tile {
      border: 0;
      background: transparent;
      box-shadow: none;
    }
    .prop-view[data-prop="1"] .media-box {
      border-radius: var(--gal-radius);
      box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    }
    .prop-view[data-prop="1"] .caption {
      padding: 10px 4px 6px;
      background: transparent;
    }
    .prop-view[data-prop="1"] .caption-title {
      font-size: 14px;
      font-weight: 500;
    }
    .prop-view[data-prop="1"] .caption-note {
      font-size: 12px;
      -webkit-line-clamp: 1;
    }

    /* PROPOSITION 2 : Classic Clean (Existant réaligné, zéro bande noire) */
    .prop-view[data-prop="2"] .filter-bar {
      display: flex;
      gap: 8px;
      margin-bottom: 22px;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .prop-view[data-prop="2"] .filter-pill {
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      cursor: pointer;
      font-weight: 500;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .prop-view[data-prop="2"] .filter-pill.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    .prop-view[data-prop="2"] .tile {
      background: var(--surface);
    }

    /* PROPOSITION 3 : Innovation Éditoriale & Dynamic Studio */
    .prop-view[data-prop="3"] .gallery-grid {
      grid-template-columns: repeat(var(--gal-cols), minmax(0, 1fr));
    }
    .prop-view[data-prop="3"] .tile.hero-spot {
      grid-column: span 2;
      grid-row: span 2;
    }
    .prop-view[data-prop="3"] .tile.hero-spot .media-box {
      aspect-ratio: 16 / 10;
    }
    .prop-view[data-prop="3"] .tile.hero-spot .caption-title {
      font-size: 20px;
    }
    .prop-view[data-prop="3"] .tile.hero-spot .caption-note {
      font-size: 14px;
      -webkit-line-clamp: 3;
    }
    .prop-view[data-prop="3"] .ambient-glow {
      position: absolute;
      inset: -14px;
      border-radius: calc(var(--gal-radius) + 12px);
      background: radial-gradient(circle at 50% 50%, rgba(59, 130, 246, var(--halo-opacity)), transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
      z-index: -1;
      pointer-events: none;
      filter: blur(16px);
    }
    .prop-view[data-prop="3"] .tile:hover .ambient-glow {
      opacity: 1;
    }
    .prop-view[data-prop="3"] .scrub-bar {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: rgba(255, 255, 255, 0.2);
      z-index: 5;
    }
    .prop-view[data-prop="3"] .scrub-fill {
      height: 100%;
      width: 0%;
      background: var(--accent);
      transition: width 0.05s linear;
    }

    /* Dossier spécial style */
    .folder-card {
      border: 1px dashed var(--border) !important;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 24px 16px;
      background: var(--surface-subtle) !important;
      cursor: pointer;
    }
    .folder-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: var(--accent-soft);
      color: var(--accent);
      display: grid;
      place-items: center;
      font-size: 20px;
      margin-bottom: 12px;
    }

    /* Notification toast */
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #10b981;
      color: #fff;
      padding: 10px 18px;
      border-radius: 8px;
      font-family: var(--font-ui);
      font-weight: 600;
      font-size: 13px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.3);
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.25s ease;
      pointer-events: none;
      z-index: 200;
    }
    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>

