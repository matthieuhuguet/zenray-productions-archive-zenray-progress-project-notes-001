/* ZenRay Sport mockups: shared tokens and components. Written 16 October 2026.
   EN: every visual value lives in :root (the HDA interface); the panel in sport-shared.js only writes these variables.
   FR : toute valeur visuelle vit dans :root ; le panneau n'écrit que ces variables. */
@font-face{font-family:'InterVariable';src:url('InterVariable.woff2') format('woff2');font-weight:100 900}
@font-face{font-family:'AnthropicSerif';src:url('AnthropicSerif-Romans.woff2') format('woff2');font-weight:300 700}
@font-face{font-family:'AnthropicMono';src:url('AnthropicMono.woff2') format('woff2')}
:root{
  /* parameters exposed in the panel (8 max) */
  --sp-hue:211;          /* accent hue, 0-360 */
  --sp-r:14px;           /* corner radius of cards */
  --sp-gap:14px;         /* spacing between blocks */
  --sp-img:132px;        /* exercise image size in cards */
  --sp-ui:14px;          /* base interface size */
  --sp-glass:0.62;       /* glass opacity */
  --sp-side:232px;       /* sidebar width */
  --sp-blur:28px;        /* glass blur */
  /* derived */
  --sp-accent:hsl(var(--sp-hue) 100% 52%);
  --sp-accent-soft:hsl(var(--sp-hue) 100% 52% / .14);
  --sp-bg:#FDFDFC; --sp-fg:#1F1F1E; --sp-muted:#6b6b67; --sp-line:rgba(0,0,0,.09);
  --sp-glass-bg:rgba(253,253,252,var(--sp-glass)); --sp-sidebar-bg:rgba(248,248,246,calc(var(--sp-glass) + .1));
  --sp-sans:'InterVariable','Hiragino Sans W4','Hiragino Sans',-apple-system,Arial,sans-serif;
  --sp-serif:'AnthropicSerif','Hiragino Mincho ProN W3',Georgia,serif;
  --sp-mono:'AnthropicMono',ui-monospace,monospace;
}
.zr-dark{--sp-bg:#1F1F1E;--sp-fg:#ECECEA;--sp-muted:#9a9a96;--sp-line:rgba(255,255,255,.10);
  --sp-glass-bg:rgba(31,31,30,var(--sp-glass));--sp-sidebar-bg:rgba(31,31,30,calc(var(--sp-glass) + .1))}
*{box-sizing:border-box}
html,body{margin:0;min-height:100vh;font:400 var(--sp-ui)/1.4 var(--sp-sans);color:var(--sp-fg)}
body{background:#e7eaf2;position:relative;isolation:isolate}
body::before{content:"";position:fixed;inset:-8%;z-index:-2;background:url('fond.webp') center/cover;filter:blur(34px) saturate(118%);transform:scale(1.08)}
body::after{content:"";position:fixed;inset:0;z-index:-1;background:rgba(232,236,244,.38)}
.zr-dark body::after,body.zr-dark::after{background:rgba(31,31,30,.62)}
button,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
.num{font-family:var(--sp-serif);font-weight:400;font-variant-numeric:tabular-nums}

/* stage: desktop window + phone */
.stage{display:flex;gap:28px;align-items:flex-start;justify-content:center;padding:22px;flex-wrap:wrap}
.win{width:min(1080px,100%);height:760px;display:flex;gap:10px;padding:10px;border-radius:22px;background:var(--sp-glass-bg);
  backdrop-filter:blur(var(--sp-blur)) saturate(200%);box-shadow:inset 0 1px 0 rgba(255,255,255,.7),0 24px 80px rgba(0,0,0,.2);position:relative;overflow:hidden}
.phone{width:390px;height:790px;border-radius:44px;border:10px solid #111;overflow:hidden;background:var(--sp-bg);flex:none;box-shadow:0 24px 60px rgba(0,0,0,.28)}
.phone iframe{width:100%;height:100%;border:0;display:block}
.tag{position:absolute;top:-1px;left:50%;transform:translateX(-50%);font:600 10px var(--sp-sans);letter-spacing:.06em;text-transform:uppercase;color:var(--sp-muted);padding:4px 10px}

/* sidebar */
.side{width:var(--sp-side);flex:none;padding:16px 14px;border-radius:calc(var(--sp-r) + 6px);background:var(--sp-sidebar-bg);
  backdrop-filter:blur(var(--sp-blur)) saturate(200%);box-shadow:inset 0 1px 0 rgba(255,255,255,.55),0 0 0 .5px var(--sp-line);display:flex;flex-direction:column;gap:3px}
.side h4{margin:12px 10px 3px;font:600 calc(var(--sp-ui)*.85)/1 var(--sp-sans);letter-spacing:.04em;text-transform:uppercase;color:var(--sp-muted)}
.side .it{display:flex;align-items:center;gap:8px;min-height:28px;padding:0 10px;border:0;border-radius:11px;background:transparent;text-align:left;letter-spacing:-.015em}
.side .it:hover{background:rgba(128,128,128,.12)}
.side .it.on{color:var(--sp-accent);background:var(--sp-accent-soft)}
.side .search{margin-bottom:6px;padding:0 10px;min-height:30px;border-radius:10px;background:rgba(128,128,128,.12);display:flex;align-items:center;color:var(--sp-muted)}

/* main */
.main{flex:1;min-width:0;border-radius:calc(var(--sp-r) + 4px);background:var(--sp-bg);box-shadow:0 0 0 .5px var(--sp-line);display:flex;flex-direction:column;overflow:hidden;position:relative}
.top{display:flex;align-items:center;gap:12px;padding:16px 20px 12px;flex-wrap:wrap}
.top h1{margin:0;font:350 calc(var(--sp-ui)*1.9)/1.1 var(--sp-serif);letter-spacing:-.01em}
.top .sp{flex:1}
.date{display:flex;align-items:center;gap:6px;padding:4px;border-radius:999px;background:rgba(128,128,128,.1)}
.date button{width:28px;height:28px;border:0;border-radius:50%;background:transparent}
.date button:hover{background:rgba(128,128,128,.18)}
.date b{font-weight:500;padding:0 6px}
.auto{font-size:calc(var(--sp-ui)*.8);color:var(--sp-muted)}
.body{flex:1;min-height:0;overflow:auto;padding:0 20px 20px}
.scroll{overflow:auto;min-height:0}

/* controls */
.search-in{display:flex;align-items:center;gap:8px;padding:0 12px;min-height:36px;border-radius:calc(var(--sp-r) - 3px);background:rgba(128,128,128,.1);border:.5px solid var(--sp-line)}
.search-in input{flex:1;border:0;outline:0;background:transparent;min-width:0}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:10px 0}
.chip{padding:5px 11px;border-radius:999px;border:.5px solid var(--sp-line);background:transparent;font-size:calc(var(--sp-ui)*.88)}
.chip.on{background:var(--sp-accent);border-color:transparent;color:#fff}
.btn{padding:8px 14px;border-radius:calc(var(--sp-r) - 3px);border:0;background:var(--sp-accent);color:#fff;font-weight:500}
.btn.ghost{background:rgba(128,128,128,.14);color:var(--sp-fg)}
.step{display:inline-flex;flex-direction:column;align-items:center;gap:3px}
.step label{font-size:calc(var(--sp-ui)*.72);text-transform:uppercase;letter-spacing:.06em;color:var(--sp-muted)}
.step .row{display:flex;align-items:center;border-radius:calc(var(--sp-r) - 4px);background:rgba(128,128,128,.12);overflow:hidden}
.step .row button{width:32px;height:34px;border:0;background:transparent;font-size:1.1em}
.step .row button:hover{background:rgba(128,128,128,.2)}
.step .row .num{min-width:36px;text-align:center;font-size:calc(var(--sp-ui)*1.2)}
.card{border-radius:var(--sp-r);background:var(--sp-bg);border:.5px solid var(--sp-line);box-shadow:0 1px 2px rgba(0,0,0,.04)}

/* image slot (placeholder until Matthieu's image bank arrives) */
.thumb{position:relative;flex:none;border-radius:calc(var(--sp-r) - 4px);overflow:hidden;display:grid;place-items:center;color:#fff;
  background:linear-gradient(145deg,hsl(var(--gh) 55% 46%),hsl(calc(var(--gh) + 30) 60% 62%))}
.thumb img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.thumb .ini{font:350 1.6em/1 var(--sp-serif);opacity:.95}
.thumb{container-type:size}.thumb .soon{display:none}@container (min-width:96px){.thumb .soon{display:block}}
.thumb .soon{position:absolute;bottom:4px;left:0;right:0;text-align:center;font-size:9px;letter-spacing:.06em;text-transform:uppercase;opacity:.75}

/* settings panel (workshop only, never shipped) */
.panel{position:fixed;right:14px;bottom:14px;width:250px;z-index:50;padding:12px 14px;border-radius:16px;background:var(--sp-glass-bg);
  backdrop-filter:blur(28px) saturate(200%);box-shadow:0 12px 40px rgba(0,0,0,.2),0 0 0 .5px var(--sp-line);font-size:12px}
.panel summary{cursor:pointer;font-weight:600}
.panel .p{display:grid;grid-template-columns:1fr auto;gap:2px 8px;margin-top:8px}
.panel .p input{grid-column:1/3;width:100%}
.panel .p span{color:var(--sp-muted)}
.panel .acts{display:flex;gap:6px;margin-top:10px}
.panel .acts button{flex:1;padding:6px;border:0;border-radius:8px;background:rgba(128,128,128,.16)}

/* mobile = embedded in the phone frame */
.embed body::before,.embed body::after{display:none}
.embed body{background:var(--sp-bg)}
.mob{height:100vh;display:flex;flex-direction:column}
.mob .main{border-radius:0;box-shadow:none}
.mob .top{padding:calc(14px + env(safe-area-inset-top)) 16px 8px}
.mob .top h1{font-size:calc(var(--sp-ui)*1.6)}
.mob .body{padding:0 16px 14px}
.tabbar{display:flex;border-top:.5px solid var(--sp-line);background:var(--sp-glass-bg);backdrop-filter:blur(20px);padding:6px 6px 14px}
.tabbar button{flex:1;border:0;background:transparent;padding:6px 0;font-size:calc(var(--sp-ui)*.8);color:var(--sp-muted);display:flex;flex-direction:column;gap:2px;align-items:center}
.tabbar button.on{color:var(--sp-accent)}
/* compact steppers on phone width so three fit on one line */
.mob .step .row button{width:26px}.mob .step .row .num{min-width:28px}
.mob .entry .steps{gap:6px}
