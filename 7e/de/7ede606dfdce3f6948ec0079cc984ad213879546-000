<script>
// Gestion de la navigation entre onglets principaux
function switchMainTab(viewId, btnEl) {
  document.querySelectorAll('.view-section').forEach(el => el.classList.remove('is-visible'));
  const target = document.getElementById('view-' + viewId);
  if (target) target.classList.add('is-visible');

  if (btnEl) {
    document.querySelectorAll('.zr-nav-pill').forEach(el => el.classList.remove('is-active'));
    btnEl.classList.add('is-active');
  }
}

// Changement global de la fonte GT Sectra active
function changeGlobalFont(fontFamilyName) {
  document.documentElement.style.setProperty('--zr-police-titres-sport', "'" + fontFamilyName + "', serif");
}

// Bascule du thème Clair / Sombre
function toggleTheme() {
  const current = document.documentElement.getAttribute('data-theme');
  const next = current === 'light' ? 'dark' : 'light';
  document.documentElement.setAttribute('data-theme', next);
}

// Affichage du panneau HDA
function toggleHda() {
  document.getElementById('hdaPanel').classList.toggle('is-collapsed');
}

// Mise à jour des variables CSS via sliders
function updateCssVar(varName, value, labelId) {
  document.documentElement.style.setProperty(varName, value);
  const el = document.getElementById(labelId);
  if (el) el.textContent = parseInt(value, 10);
}

// Copie des réglages pour le prompt
function copyHdaValues() {
  const font = document.getElementById('fontPicker').value;
  const radius = getComputedStyle(document.documentElement).getPropertyValue('--capsule-radius').trim();
  const pad = getComputedStyle(document.documentElement).getPropertyValue('--capsule-pad').trim();
  const titleSize = getComputedStyle(document.documentElement).getPropertyValue('--title-size').trim();
  const summary = `Réglages Sport Last Sessions HDA (23 October 2026) :
- Fonte active : ${font}
- Rayon capsule : ${radius}
- Padding : ${pad}
- Taille titre : ${titleSize}`;
  navigator.clipboard.writeText(summary).then(() => {
    alert('Valeurs copiées dans le presse-papier !');
  });
}
</script>
